PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Catalog cache in seconds. Use 0 to disable stored entries locally.
BROWSE_CACHE_TTL_SECONDS=30
FFMPEG_PATH=ffmpeg
MEDIA_SIGNING_SECRET=replace-with-an-independent-strong-random-secret
MEDIA_URL_TTL_SECONDS=900
# Public hostname of a CDN configured to proxy /stream to this BFF. Leave empty locally.
MEDIA_CDN_BASE_URL=
# Configure these variables to use AWS S3, Cloudflare R2, MinIO or another S3-compatible store.
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT=
MEDIA_S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://cinevault:cinevault@localhost:5432/cinevault
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM=Cinevault <mailer@example.com>
# Stripe Checkout. Use sk_test/whsec in development and secret-manager values in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
